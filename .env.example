# Application
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/passwordmanager
DB_HOST=localhost
DB_PORT=5432
DB_NAME=passwordmanager
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server
SERVER_PORT=3000
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption
SERVER_ENCRYPTION_KEY=your-server-side-encryption-key-32-bytes-change-this

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@passwordmanager.com

# HaveIBeenPwned API (Optional)
HIBP_API_KEY=

# Session
SESSION_TIMEOUT=900000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
